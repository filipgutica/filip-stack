          "name": "workflow",
          "manifest_path": ".codex-plugin/plugin.json",
          "manifest": {
            "name": "workflow",
            "version": "5.2.0",
            "description": "A small engineering workflow for planning, implementation, review, technical writing, and guided walkthroughs.",
            "author": {
              "name": "Filip Gutica"
            },
            "skills": "./skills",
            "interface": {
              "displayName": "Engineering Workflow",
              "shortDescription": "Plan, build, verify, explain, and review engineering work.",
              "longDescription": "Nine focused skills cover planning, authorized engineering changes, read-only review, explicit code simplification, test quality audits, concise technical writing, adversarial design interviews, guided walkthroughs, and checkpoints for pausing or handing off work. Guidance is loaded progressively and keeps changes bounded, simple, reusable, and independently verifiable.",
              "developerName": "Filip Gutica",
              "category": "Productivity",
              "capabilities": [
                "Interactive",
                "Write",
                "Review"
              ],
              "defaultPrompt": [
                "Use $workflow:engineering for authorized code changes, debugging, refactoring, and review corrections.",
                "Use $workflow:review for read-only review or final verification of an exact range or artifact.",
                "Use $workflow:planning for specs, plans, tickets, or exploration; use $workflow:technical-writing for prose."
              ]
            }
          },
