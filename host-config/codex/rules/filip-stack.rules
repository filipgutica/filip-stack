# Filip Stack guardrails for Codex. Codex hooks cannot ask yet, so these rules
# prompt before a pull request merge and before any 1Password CLI call.

prefix_rule(
    pattern = ["gh", "pr", "merge"],
    decision = "prompt",
    justification = "Merging a pull request needs explicit user authorization.",
    match = ["gh pr merge 12 --squash"],
    not_match = ["gh pr view 12"],
)

prefix_rule(
    pattern = ["op"],
    decision = "prompt",
    justification = "1Password CLI access needs user approval. State the exact vault, item, and field, why you need it, and the scope of data you will retrieve.",
    match = ["op read op://vault/item/field"],
    not_match = ["grep op notes.txt"],
)
