{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://filip-stack.local/workflow/field-guide/memory-v1.schema.json",
  "title": "Field-guide memory store version 1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "revision", "guidance", "evidence"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "revision": { "type": "integer", "minimum": 0 },
    "guidance": { "type": "array", "items": { "$ref": "#/$defs/guidance" } },
    "evidence": { "type": "array", "items": { "$ref": "#/$defs/evidence" } }
  },
  "$defs": {
    "scope": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": { "kind": { "const": "shared" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "repositoryIdentity"],
          "properties": {
            "kind": { "const": "project" },
            "repositoryIdentity": { "type": "string", "minLength": 1, "maxLength": 1024 }
          }
        }
      ]
    },
    "relationship": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "targetId"],
      "properties": {
        "kind": { "enum": ["reinforces", "refines", "contradicts"] },
        "targetId": { "type": "string", "pattern": "^guidance:v1:[0-9a-f]{64}$" }
      }
    },
    "example": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "language", "code"],
      "properties": {
        "kind": { "enum": ["pattern", "antipattern"] },
        "language": { "type": "string", "minLength": 1, "maxLength": 64 },
        "code": { "type": "string", "minLength": 1, "maxLength": 6144 }
      }
    },
    "transition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to", "reason", "source", "at"],
      "properties": {
        "from": { "type": ["string", "null"], "enum": [null, "candidate", "active", "superseded", "withdrawn", "archived"] },
        "to": { "enum": ["candidate", "active", "superseded", "withdrawn", "archived"] },
        "reason": { "type": "string", "minLength": 1, "maxLength": 512 },
        "source": { "type": "string", "minLength": 1, "maxLength": 128 },
        "at": { "type": "string", "format": "date-time" },
        "replacementId": { "type": "string", "pattern": "^guidance:v1:[0-9a-f]{64}$" }
      }
    },
    "guidance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "fingerprint", "scope", "subjectKey", "learning", "status", "confidence", "examples", "evidenceIds", "independentEvidenceCount", "transitions", "createdAt", "updatedAt"],
      "properties": {
        "id": { "type": "string", "pattern": "^guidance:v1:[0-9a-f]{64}$" },
        "fingerprint": { "type": "string", "pattern": "^fingerprint:v1:[0-9a-f]{64}$" },
        "scope": { "$ref": "#/$defs/scope" },
        "subjectKey": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "learning": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "status": { "enum": ["candidate", "active", "superseded", "withdrawn", "archived"] },
        "confidence": { "enum": ["low", "medium", "high"] },
        "generic": { "type": "boolean" },
        "relationship": { "$ref": "#/$defs/relationship" },
        "examples": { "type": "array", "maxItems": 2, "items": { "$ref": "#/$defs/example" } },
        "evidenceIds": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^evidence:v1:[0-9a-f-]{36}$" } },
        "independentEvidenceCount": { "type": "integer", "minimum": 0 },
        "transitions": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/transition" } },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      }
    },
    "pointer": {
      "oneOf": [
        { "$ref": "#/$defs/conversationPointer" },
        { "$ref": "#/$defs/reviewPointer" },
        { "$ref": "#/$defs/commitPointer" },
        { "$ref": "#/$defs/localArtifactPointer" },
        { "$ref": "#/$defs/manualPointer" }
      ]
    },
    "conversationPointer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "client", "threadId"],
      "properties": {
        "kind": { "const": "conversation" },
        "client": { "type": "string", "minLength": 1, "maxLength": 256 },
        "threadId": { "type": "string", "minLength": 1, "maxLength": 256 },
        "messageId": { "type": "string", "minLength": 1, "maxLength": 256 },
        "turnId": { "type": "string", "minLength": 1, "maxLength": 256 },
        "url": { "type": "string", "format": "uri", "maxLength": 2048 }
      }
    },
    "reviewPointer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "provider", "repositoryIdentity", "pullRequestNumber", "commentId"],
      "properties": {
        "kind": { "const": "review" },
        "provider": { "type": "string", "minLength": 1, "maxLength": 256 },
        "repositoryIdentity": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "pullRequestNumber": { "type": "integer", "minimum": 1 },
        "commentId": { "type": "string", "minLength": 1, "maxLength": 256 },
        "url": { "type": "string", "format": "uri", "maxLength": 2048 }
      }
    },
    "commitPointer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "repositoryIdentity", "commit"],
      "properties": {
        "kind": { "const": "commit" },
        "repositoryIdentity": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
      }
    },
    "localArtifactPointer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "repositoryIdentity", "path", "contentDigest"],
      "properties": {
        "kind": { "const": "local-artifact" },
        "repositoryIdentity": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "path": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "heading": { "type": "string", "minLength": 1, "maxLength": 256 },
        "contentDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
      }
    },
    "manualPointer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "sourceLabel"],
      "properties": {
        "kind": { "const": "manual" },
        "sourceLabel": { "type": "string", "minLength": 1, "maxLength": 512 }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "summary", "pointers", "sourceKeys", "countsForPromotion", "createdAt"],
      "properties": {
        "id": { "type": "string", "pattern": "^evidence:v1:[0-9a-f-]{36}$" },
        "summary": { "type": "string", "minLength": 1, "maxLength": 512 },
        "pointers": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/pointer" } },
        "sourceKeys": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^source:v1:[0-9a-f]{64}$" } },
        "countsForPromotion": { "type": "boolean" },
        "repositoryIdentity": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    }
  }
}
