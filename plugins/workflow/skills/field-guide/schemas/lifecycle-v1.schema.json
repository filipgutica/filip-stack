{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://filip-stack.local/workflow/field-guide/lifecycle-v1.schema.json",
  "title": "Field-guide lifecycle operation version 1",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "action", "targetId", "reason", "source"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "action": { "enum": ["activate", "supersede", "undo", "withdraw"] },
        "targetId": { "type": "string", "pattern": "^guidance:v1:[0-9a-f]{64}$" },
        "replacementId": { "type": "string", "pattern": "^guidance:v1:[0-9a-f]{64}$" },
        "confirmed": { "type": "boolean" },
        "reason": { "type": "string", "minLength": 1, "maxLength": 512 },
        "source": { "type": "string", "minLength": 1, "maxLength": 128 }
      },
      "allOf": [
        {
          "if": { "properties": { "action": { "const": "supersede" } } },
          "then": {
            "required": ["replacementId", "confirmed"],
            "properties": { "confirmed": { "const": true } }
          },
          "else": {
            "not": {
              "anyOf": [
                { "required": ["replacementId"] },
                { "required": ["confirmed"] }
              ]
            }
          }
        }
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "targetId"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "targetId": { "type": "string", "pattern": "^guidance:v1:[0-9a-f]{64}$" },
        "apply": { "type": "boolean" },
        "previewToken": { "type": "string" }
      }
    }
  ]
}
