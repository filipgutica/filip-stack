{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://filip-stack.local/workflow/field-guide/maintenance-v1.schema.json",
  "title": "Field-guide maintenance input version 1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "action", "targetIds", "reason"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "action": { "const": "archive" },
    "targetIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^guidance:v1:[0-9a-f]{64}$" }
    },
    "reason": { "type": "string", "minLength": 1, "maxLength": 512 },
    "apply": { "type": "boolean" },
    "previewToken": { "type": "string", "maxLength": 128 }
  },
  "allOf": [
    {
      "if": { "properties": { "apply": { "const": true } }, "required": ["apply"] },
      "then": { "required": ["previewToken"] },
      "else": { "not": { "required": ["previewToken"] } }
    }
  ]
}
