{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://filip-stack.local/workflow/field-guide/submission-v1.schema.json",
  "title": "Field-guide observation submission version 1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "decision", "confidence", "scope", "subjectKey", "learning", "evidence"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "decision": { "const": "capture" },
    "confidence": { "enum": ["low", "medium", "high"] },
    "scope": { "enum": ["project", "shared"] },
    "subjectKey": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "learning": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "relationship": { "$ref": "memory-v1.schema.json#/$defs/relationship" },
    "reason": { "type": "string", "minLength": 1, "maxLength": 512 },
    "explicitPreference": { "type": "boolean" },
    "generic": { "type": "boolean" },
    "examples": { "type": "array", "maxItems": 2, "items": { "$ref": "memory-v1.schema.json#/$defs/example" } },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "pointers"],
      "properties": {
        "summary": { "type": "string", "minLength": 1, "maxLength": 512 },
        "pointers": { "type": "array", "minItems": 1, "items": { "$ref": "memory-v1.schema.json#/$defs/pointer" } }
      }
    }
  }
}
