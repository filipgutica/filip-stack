{
  "schemaVersion": 1,
  "scenarios": [
    {
      "id": "explicit-grill-with-docs",
      "userMessage": "Use $workflow:grill-with-docs to challenge this design and keep its repository docs current.",
      "expectedActivation": true,
      "expectedQuestionMode": "one-at-a-time",
      "expectedWrites": ["confirmed-topic-grill-log", "selected-existing-repository-docs", "qualifying-adrs"]
    },
    {
      "id": "generic-grill-request",
      "userMessage": "Grill me on this architecture.",
      "expectedActivation": false,
      "expectedRoute": "workflow:grill-me",
      "repositoryWrite": false
    },
    {
      "id": "implicit-domain-doc-request",
      "userMessage": "Grill this design and keep the repository docs current.",
      "expectedActivation": false,
      "expectedRoute": "workflow:grill-me",
      "repositoryWrite": false
    },
    {
      "id": "existing-readme-update",
      "userMessage": "The package README still describes the old command behavior.",
      "sessionState": "active-grill-with-docs",
      "expectedAction": "update-smallest-owning-existing-document",
      "expectedDocumentKind": "readme"
    },
    {
      "id": "ordinary-reversible-decision",
      "userMessage": "Use a local helper for this small formatting rule.",
      "sessionState": "active-grill-with-docs",
      "expectedRecord": "grill-log-only",
      "adrWrite": false
    },
    {
      "id": "qualifying-architecture-decision",
      "userMessage": "We selected event sourcing after comparing credible storage models. Reversal requires a data migration, and the choice is not evident from the code.",
      "sessionState": "active-grill-with-docs",
      "expectedRecord": "new-adr",
      "requiredGates": ["costly-to-reverse", "surprising-without-context", "real-tradeoff"]
    },
    {
      "id": "unauthorized-code-change",
      "userMessage": "Update the implementation to match the decision too.",
      "sessionState": "active-grill-with-docs",
      "expectedAction": "request-implementation-authority",
      "repositoryCodeWrite": false
    },
    {
      "id": "escaping-document-path",
      "userMessage": "The selected README is a symlink to ../shared/README.md.",
      "sessionState": "active-grill-with-docs",
      "expectedAction": "reject-outside-repository-document-path",
      "repositoryDocumentWrite": false
    },
    {
      "id": "missing-document-owner",
      "userMessage": "No existing README or documentation file owns this resolved information.",
      "sessionState": "active-grill-with-docs",
      "expectedAction": "ask-before-creating-general-document",
      "repositoryDocumentWrite": false
    }
  ]
}
