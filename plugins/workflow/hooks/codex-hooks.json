{
  "description": "Prompt bounded field-guide use before the final response.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh \"${PLUGIN_ROOT}/scripts/run-node.sh\" --fail-open \"${PLUGIN_ROOT}/hooks/field-guide-lifecycle.mjs\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
