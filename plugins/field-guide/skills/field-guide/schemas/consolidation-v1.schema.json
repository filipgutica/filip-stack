{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://filip-stack.local/field-guide/consolidation-v1.schema.json",
  "title": "Field-guide consolidate input version 1",
  "description": "Replaces 2 to 8 active records of one scope and subject with one new record. It carries no confirmation field: consolidating a confirmed record needs the user's approval of a stored proposal.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "targetIds", "replacement", "reason", "source"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "targetIds": { "$ref": "#/$defs/targetIds" },
    "replacement": { "$ref": "#/$defs/replacement" },
    "reason": { "type": "string", "minLength": 1, "maxLength": 512 },
    "source": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^\\S+$" },
    "apply": { "type": "boolean" },
    "previewToken": { "type": "string", "maxLength": 128, "pattern": "^\\S+$" }
  },
  "$defs": {
    "targetIds": {
      "type": "array",
      "minItems": 2,
      "maxItems": 8,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^guidance:v1:[0-9a-f]{64}$" }
    },
    "replacement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["learning", "confidence"],
      "properties": {
        "learning": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "confidence": { "enum": ["low", "medium", "high"] },
        "examples": { "type": "array", "maxItems": 2 }
      }
    }
  }
}
