{
  "name": "filip-stack",
  "version": "1.12.0",
  "private": true,
  "type": "module",
  "repository": "https://github.com/filipgutica/filip-stack.git",
  "engines": {
    "node": ">=20.16.0"
  },
  "scripts": {
    "postinstall": "lefthook install",
    "stamp-version": "node scripts/stamp-version.mjs",
    "test:engineering-workflow": "node --test plugins/workflow/skills/setup/scripts/engineering-workflow.test.mjs",
    "test:source-provenance": "node plugins/workflow/skills/setup/scripts/validate-source-provenance-contract.mjs",
    "test:field-guide-hooks": "node --test plugins/workflow/hooks/field-guide-lifecycle.test.mjs",
    "test:field-guide": "node --test plugins/workflow/skills/field-guide/scripts/field-guide.test.mjs",
    "test:field-guide-contract": "node plugins/workflow/skills/field-guide/scripts/validate-contract.mjs",
    "test:grill-me": "node plugins/workflow/skills/grill-me/scripts/validate-contract.mjs",
    "test:pr-descriptions": "node plugins/workflow/skills/writing-pr-descriptions/scripts/validate-contract.mjs",
    "test:walkthrough": "node plugins/workflow/skills/walkthrough/scripts/validate-contract.mjs",
    "test:writing-specs": "node plugins/workflow/skills/writing-specs/scripts/validate-contract.mjs",
    "test:writing-tickets": "node plugins/workflow/skills/writing-tickets/scripts/validate-contract.mjs",
    "validate-plugins": "node scripts/validate-plugins.mjs",
    "check": "pnpm test:engineering-workflow && pnpm test:source-provenance && pnpm test:field-guide-hooks && pnpm test:field-guide && pnpm test:field-guide-contract && pnpm test:grill-me && pnpm test:pr-descriptions && pnpm test:walkthrough && pnpm test:writing-specs && pnpm test:writing-tickets && pnpm validate-plugins"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.0",
    "@commitlint/config-conventional": "^19.8.0",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/exec": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "ajv": "^8.18.0",
    "lefthook": "^1.11.13",
    "semantic-release": "^24.2.5"
  }
}
