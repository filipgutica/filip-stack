{
  "name": "filip-stack",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "repository": "https://github.com/filipgutica/filip-stack.git",
  "engines": {
    "node": ">=20.16.0"
  },
  "scripts": {
    "postinstall": "lefthook install",
    "stamp-version": "node scripts/stamp-version.mjs",
    "test:workflow-contracts": "node tests/workflow/validate-contracts.mjs",
    "test:field-guide-boundary": "node tests/field-guide/validate-plugin-boundary.mjs",
    "test:field-guide-contract": "node tests/field-guide/validate-contract.mjs",
    "test:field-guide-hooks": "node --test tests/field-guide/field-guide-lifecycle.test.mjs",
    "test:field-guide": "node --test tests/field-guide/field-guide.test.mjs",
    "test:plugin-payload": "node --test tests/workflow/plugin-payload-policy.test.mjs",
    "validate-plugins": "node scripts/validate-plugins.mjs",
    "check": "pnpm test:workflow-contracts && pnpm test:field-guide-boundary && pnpm test:field-guide-contract && pnpm test:field-guide-hooks && pnpm test:field-guide && pnpm test:plugin-payload && pnpm validate-plugins"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.0",
    "@commitlint/config-conventional": "^19.8.0",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/exec": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "ajv": "^8.18.0",
    "lefthook": "^1.11.13",
    "semantic-release": "^24.2.5"
  }
}
