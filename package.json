{
  "name": "filip-stack",
  "version": "1.15.0",
  "private": true,
  "type": "module",
  "repository": "https://github.com/filipgutica/filip-stack.git",
  "engines": {
    "node": ">=20.16.0"
  },
  "scripts": {
    "postinstall": "lefthook install",
    "test:coordinator": "node tests/workflow/skills/coordinator/validate-contract.mjs",
    "stamp-version": "node scripts/stamp-version.mjs",
    "test:engineering-workflow": "node --test tests/workflow/skills/setup/engineering-workflow.test.mjs",
    "test:source-provenance": "node tests/workflow/skills/setup/validate-source-provenance-contract.mjs",
    "test:field-guide-hooks": "node --test tests/workflow/hooks/field-guide-lifecycle.test.mjs",
    "test:field-guide": "node --test tests/workflow/skills/field-guide/field-guide.test.mjs",
    "test:field-guide-contract": "node tests/workflow/skills/field-guide/validate-contract.mjs",
    "test:grill-me": "node tests/workflow/skills/grill-me/validate-contract.mjs",
    "test:grill-with-docs": "node tests/workflow/skills/grill-with-docs/validate-contract.mjs",
    "test:pr-descriptions": "node tests/workflow/skills/writing-pr-descriptions/validate-contract.mjs",
    "test:plugin-payload": "node --test tests/workflow/plugin-payload-policy.test.mjs",
    "test:walkthrough": "node tests/workflow/skills/walkthrough/validate-contract.mjs",
    "test:writing-specs": "node tests/workflow/skills/writing-specs/validate-contract.mjs",
    "test:writing-tickets": "node tests/workflow/skills/writing-tickets/validate-contract.mjs",
    "validate-plugins": "node scripts/validate-plugins.mjs",
    "check": "pnpm test:coordinator && pnpm test:engineering-workflow && pnpm test:source-provenance && pnpm test:field-guide-hooks && pnpm test:field-guide && pnpm test:field-guide-contract && pnpm test:grill-me && pnpm test:grill-with-docs && pnpm test:pr-descriptions && pnpm test:plugin-payload && pnpm test:walkthrough && pnpm test:writing-specs && pnpm test:writing-tickets && pnpm validate-plugins"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.0",
    "@commitlint/config-conventional": "^19.8.0",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/exec": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "ajv": "^8.18.0",
    "lefthook": "^1.11.13",
    "semantic-release": "^24.2.5"
  }
}
