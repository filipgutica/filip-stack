{
  "name": "filip-stack",
  "version": "4.3.0",
  "private": true,
  "type": "module",
  "bin": {
    "filip-stack": "cli/filip-stack.mjs"
  },
  "packageManager": "pnpm@10.34.7",
  "repository": "https://github.com/filipgutica/filip-stack.git",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "postinstall": "lefthook install",
    "stamp-version": "node scripts/stamp-version.mjs",
    "host-config": "node scripts/host-config.mjs",
    "eval:routing": "node scripts/eval-routing.mjs",
    "test:workflow-contracts": "node tests/workflow/validate-contracts.mjs",
    "test:skills": "node tests/skills/validate-skills.mjs && node --test tests/skills/hill-climb-build-runs.test.mjs tests/skills/interface-design-scripts.test.mjs && python3 -B -m unittest discover -s tests/skills -p '*_test.py'",
    "test:field-guide-boundary": "node tests/field-guide/validate-plugin-boundary.mjs",
    "test:field-guide-contract": "node tests/field-guide/validate-contract.mjs",
    "test:field-guide-hooks": "node --test tests/field-guide/field-guide-lifecycle.test.mjs",
    "test:field-guide": "node --test tests/field-guide/field-guide.test.mjs tests/field-guide/field-guide-analytics.test.mjs",
    "test:guardrails": "node --test tests/guardrails/guardrails.test.mjs",
    "test:host-config": "node --test tests/host-config/host-config.test.mjs tests/host-config/cli.test.mjs tests/host-config/data-visualizations.test.mjs tests/host-config/design-foundations.test.mjs",
    "test:plugin-payload": "node --test tests/workflow/plugin-payload-policy.test.mjs",
    "validate-plugins": "node scripts/validate-plugins.mjs",
    "check": "pnpm test:workflow-contracts && pnpm test:skills && pnpm test:field-guide-boundary && pnpm test:field-guide-contract && pnpm test:field-guide-hooks && pnpm test:field-guide && pnpm test:guardrails && pnpm test:plugin-payload && pnpm test:host-config && pnpm validate-plugins && pnpm test:static",
    "test:static": "pnpm test:static:dead-code && pnpm test:static:health && pnpm test:static:dupes",
    "test:static:dead-code": "fallow dead-code --baseline fallow-baselines/dead-code.json --fail-on-issues",
    "test:static:health": "fallow health --complexity --baseline-mode identity --baseline fallow-baselines/health.json",
    "test:static:dupes": "node scripts/check-fallow-dupes.mjs"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.0",
    "@commitlint/config-conventional": "^19.8.0",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/exec": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "ajv": "^8.18.0",
    "fallow": "3.18.0",
    "lefthook": "^1.11.13",
    "semantic-release": "^24.2.5"
  }
}
